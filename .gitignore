# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
*.jks
*.keystore
/.android-secrets/
/.android-tools/
/mobile/android/app/google-services.json
/mobile/dist/
/mobile/node_modules/
/mobile/*.js
/mobile/*.d.ts
/mobile/*.tsbuildinfo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
tsconfig.tsbuildinfo
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/
